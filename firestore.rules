rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signed() { return request.auth != null; }
    function owner(uid) { return signed() && request.auth.uid == uid; }
    function accepted(a, b) {
      let p = /databases/$(db)/documents/friendRequests/$(a + '_' + b);
      return existsAfter(p) && getAfter(p).data.status == 'accepted';
    }
    function isFriend(a, b) {
      return exists(/databases/$(db)/documents/friendships/$(a + '_' + b))
          || exists(/databases/$(db)/documents/friendships/$(b + '_' + a));
    }

    match /users/{uid} {
      allow read: if signed();
      allow create, update: if owner(uid)
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.keys().hasOnly(['name', 'photo', 'totalSaved', 'tripCount']);
      allow delete: if owner(uid);

      match /trips/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['mode', 'km', 'saved', 'ts', 'locality', 'factorVersion'])
          && request.resource.data.mode in ['walk', 'cycle', 'metro', 'bus', 'car']
          && request.resource.data.km is number && request.resource.data.km > 0 && request.resource.data.km <= 500
          && request.resource.data.saved is int && request.resource.data.saved >= 0
          && request.resource.data.saved <= request.resource.data.km * 192 + 1
          && request.resource.data.ts is number;
      }
      // Create-only + deterministic id (day_mission) => a mission can be claimed once per day.
      match /missionClaims/{id} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['missionId', 'day', 'xp', 'ts'])
          && id == request.resource.data.day + '_' + request.resource.data.missionId
          && request.resource.data.xp == ({'walk': 50, 'green': 75, 'save': 25})[request.resource.data.missionId];
      }
      match /joined/{cid} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid)
          && request.resource.data.keys().hasOnly(['mode', 'friendUid', 'friendName', 'joinedAt'])
          && (request.resource.data.mode == 'solo'
              || (request.resource.data.mode == 'friend' && isFriend(uid, request.resource.data.friendUid)));
      }
    }

    match /friendRequests/{id} {
      allow read: if signed() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['senderId', 'recipientId', 'senderName', 'status', 'ts'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid
        && id == request.auth.uid + '_' + request.resource.data.recipientId
        && request.resource.data.status == 'pending';
      allow update: if signed() && resource.data.recipientId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted', 'declined'];
      allow delete: if signed() && (resource.data.senderId == request.auth.uid || resource.data.recipientId == request.auth.uid);
    }

    match /friendships/{id} {
      allow read: if signed() && request.auth.uid in resource.data.members;
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['members', 'names', 'ts'])
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && id == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && (accepted(request.resource.data.members[0], request.resource.data.members[1])
            || accepted(request.resource.data.members[1], request.resource.data.members[0]));
      allow delete: if signed() && request.auth.uid in resource.data.members;
    }

    // Chat id == friendship id; only the two members can read/write.
    match /chats/{cid}/messages/{mid} {
      allow read: if signed() && request.auth.uid in get(/databases/$(db)/documents/friendships/$(cid)).data.members;
      allow create: if signed()
        && request.auth.uid in get(/databases/$(db)/documents/friendships/$(cid)).data.members
        && request.resource.data.keys().hasOnly(['senderId', 'senderName', 'text', 'createdAt'])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.createdAt == request.time;
    }

    // Aggregate-only community stats (no per-user locations are ever stored here).
    match /localityAggregates/{id} {
      allow read: if signed();
      allow create: if signed()
        && request.resource.data.keys().hasOnly(['name', 'trips', 'saved'])
        && request.resource.data.trips == 1
        && request.resource.data.saved >= 0 && request.resource.data.saved <= 100000;
      allow update: if signed()
        && request.resource.data.keys().hasOnly(['name', 'trips', 'saved'])
        && request.resource.data.trips == resource.data.trips + 1
        && request.resource.data.saved >= resource.data.saved
        && request.resource.data.saved - resource.data.saved <= 100000;
    }
  }
}
